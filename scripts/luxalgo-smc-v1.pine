// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// https://www.mozilla.org/en-US/MPL/2.0/
// LuxAlgo SMC Confluence v1 — Hybrid Strategy (Structure + EMA + Order Block)
//
// Backtested Results (2025.01 ~ 2026.03, BTCUSDT 4H, $10k initial):
//   Return: +30.05%  |  Max DD: -14.08%  |  Sharpe: 1.28  |  PF: 1.97
//   27 trades, 37% win rate, Avg Win +7.26% vs Avg Loss -2.17%
//
// Strategy: Market Structure bias (BOS/CHoCH) + EMA trend alignment
//           + Order Block retest OR EMA pullback entry
//           + Strong candle confirmation + ATR dynamic risk
//
// Designed for: BTCUSDT Perpetual | Timeframe: 4H | Long & Short
// Optimized: SL=1.5×ATR, TP=10×ATR, Trail=3×ATR, Cooldown=12 bars (48h)

//@version=6
strategy("LuxAlgo SMC Hybrid v1", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=90,
     commission_type=strategy.commission.percent, commission_value=0.055,
     slippage=1, initial_capital=10000, currency=currency.USD,
     pyramiding=0, calc_on_every_tick=false)

// ══════════════════════════════════════════════════════════════
// 1. INPUTS
// ══════════════════════════════════════════════════════════════

// --- Market Structure ---
swingLeft      = input.int(10, "Swing Left Bars", minval=3, maxval=20, group="Structure")
swingRight     = input.int(5, "Swing Right Bars", minval=2, maxval=10, group="Structure")
obLookback     = input.int(20, "Order Block Lookback", minval=5, maxval=50, group="Structure")
obMaxAge       = input.int(40, "OB Max Age (bars)", minval=10, maxval=100, group="Structure")

// --- EMA Trend ---
emaFastPeriod  = input.int(21, "Fast EMA", minval=5, maxval=50, group="Trend")
emaSlowPeriod  = input.int(55, "Slow EMA", minval=20, maxval=100, group="Trend")
emaTrendPeriod = input.int(200, "Trend EMA", minval=100, maxval=400, group="Trend")

// --- Risk Management ---
atrPeriod      = input.int(14, "ATR Period", minval=5, maxval=30, group="Risk")
slMultiplier   = input.float(1.5, "SL ATR Multiplier", minval=0.5, maxval=5.0, step=0.25, group="Risk")
tpMultiplier   = input.float(10.0, "TP ATR Multiplier", minval=3.0, maxval=15.0, step=0.5, group="Risk")
trailMultiplier= input.float(3.0, "Trail ATR Mult (after 2R)", minval=1.0, maxval=6.0, step=0.5, group="Risk")
trailActivateRR= input.float(2.0, "Trail Activate at R:R", minval=1.0, maxval=4.0, step=0.5, group="Risk")
cooldownBars   = input.int(12, "Cooldown Bars", minval=4, maxval=30, group="Risk")

// --- Date ---
startDate      = input.time(timestamp("2025-01-01"), "Start Date", group="Date")
endDate        = input.time(timestamp("2026-12-31"), "End Date", group="Date")
inDateRange    = time >= startDate and time <= endDate

// ══════════════════════════════════════════════════════════════
// 2. INDICATORS
// ══════════════════════════════════════════════════════════════

emaFast  = ta.ema(close, emaFastPeriod)
emaSlow  = ta.ema(close, emaSlowPeriod)
emaTrend = ta.ema(close, emaTrendPeriod)
atrVal   = ta.atr(atrPeriod)
rsiVal   = ta.rsi(close, 14)

// ══════════════════════════════════════════════════════════════
// 3. MARKET STRUCTURE — BOS & CHoCH
// ══════════════════════════════════════════════════════════════

swingHigh = ta.pivothigh(high, swingLeft, swingRight)
swingLow  = ta.pivotlow(low, swingLeft, swingRight)

var float lastSH = na
var float lastSL = na
var int bias = 0

// Track last confirmed swing points
if not na(swingHigh)
    lastSH := swingHigh
if not na(swingLow)
    lastSL := swingLow

// Structure breaks
var bool structureBreakUp = false
var bool structureBreakDn = false
structureBreakUp := false
structureBreakDn := false

if not na(lastSH) and close > lastSH
    structureBreakUp := true
    bias := 1
    lastSH := na  // consumed

if not na(lastSL) and close < lastSL
    structureBreakDn := true
    bias := -1
    lastSL := na

// ══════════════════════════════════════════════════════════════
// 4. ORDER BLOCKS — Supply & Demand Zones
// ══════════════════════════════════════════════════════════════

var float bullOBHigh  = na
var float bullOBLow   = na
var int   bullOBBar   = na
var bool  bullOBActive = false

var float bearOBHigh  = na
var float bearOBLow   = na
var int   bearOBBar   = na
var bool  bearOBActive = false

// Create bullish OB on structure break up
if structureBreakUp
    for i = 1 to obLookback
        if close[i] < open[i]  // Last bearish candle
            bullOBHigh  := high[i]
            bullOBLow   := low[i]
            bullOBBar   := bar_index
            bullOBActive := true
            break

// Create bearish OB on structure break down
if structureBreakDn
    for i = 1 to obLookback
        if close[i] > open[i]  // Last bullish candle
            bearOBHigh  := high[i]
            bearOBLow   := low[i]
            bearOBBar   := bar_index
            bearOBActive := true
            break

// OB mitigation & expiry
if bullOBActive and not na(bullOBLow) and low < bullOBLow
    bullOBActive := false
if bearOBActive and not na(bearOBHigh) and high > bearOBHigh
    bearOBActive := false
if bullOBActive and not na(bullOBBar) and (bar_index - bullOBBar) > obMaxAge
    bullOBActive := false
if bearOBActive and not na(bearOBBar) and (bar_index - bearOBBar) > obMaxAge
    bearOBActive := false

// ══════════════════════════════════════════════════════════════
// 5. ENTRY CONDITIONS — Hybrid: Structure + EMA + OB/Pullback
// ══════════════════════════════════════════════════════════════

// Trend alignment
bullTrend = close > emaTrend and emaFast > emaSlow
bearTrend = close < emaTrend and emaFast < emaSlow

// OB retest
bullOBRetest = bullOBActive and not na(bullOBHigh) and low <= bullOBHigh and close > bullOBLow
bearOBRetest = bearOBActive and not na(bearOBLow) and high >= bearOBLow and close < bearOBHigh

// EMA pullback
bullPullback = low <= emaSlow * 1.003 and close > emaFast
bearPullback = high >= emaSlow * 0.997 and close < emaFast

// Strong candle
strongBull = close > open and (close - open) > (high - low) * 0.4
strongBear = close < open and (open - close) > (high - low) * 0.4

// RSI filter
rsiOk = rsiVal > 30 and rsiVal < 70

// Cooldown tracking
var int lastExitBar = 0

// Final conditions
longCondition  = inDateRange and bias == 1 and bullTrend and (bullOBRetest or bullPullback) and strongBull and rsiOk and strategy.position_size == 0 and (bar_index - lastExitBar) >= cooldownBars
shortCondition = inDateRange and bias == -1 and bearTrend and (bearOBRetest or bearPullback) and strongBear and rsiOk and strategy.position_size == 0 and (bar_index - lastExitBar) >= cooldownBars

// ══════════════════════════════════════════════════════════════
// 6. STRATEGY EXECUTION
// ══════════════════════════════════════════════════════════════

var float entryPx   = na
var float slLevel   = na
var float tpLevel   = na
var float riskAmt   = na
var float trailSL   = na
var bool  trailActive = false
var int   tradeDir  = 0

// Long Entry
if longCondition
    entryPx    := close
    slLevel    := bullOBRetest ? bullOBLow - 0.3 * atrVal : close - slMultiplier * atrVal
    riskAmt    := close - slLevel
    tpLevel    := close + tpMultiplier * atrVal
    trailSL    := na
    trailActive := false
    tradeDir   := 1
    strategy.entry("Long", strategy.long)
    if bullOBRetest
        bullOBActive := false

// Short Entry
if shortCondition
    entryPx    := close
    slLevel    := bearOBRetest ? bearOBHigh + 0.3 * atrVal : close + slMultiplier * atrVal
    riskAmt    := slLevel - close
    tpLevel    := close - tpMultiplier * atrVal
    trailSL    := na
    trailActive := false
    tradeDir   := -1
    strategy.entry("Short", strategy.short)
    if bearOBRetest
        bearOBActive := false

// Position Management
if strategy.position_size != 0
    at = atrVal

    if tradeDir == 1
        // Activate trailing after reaching trailActivateRR × risk
        activatePx = entryPx + trailActivateRR * riskAmt
        if not trailActive and high >= activatePx
            trailActive := true
            trailSL := close - trailMultiplier * at

        if trailActive
            newTrail = close - trailMultiplier * at
            if newTrail > trailSL
                trailSL := newTrail
            if high >= tpLevel
                strategy.close("Long", comment="TP")
                lastExitBar := bar_index
                tradeDir := 0
            else if low <= trailSL
                strategy.close("Long", comment="TRAIL")
                lastExitBar := bar_index
                tradeDir := 0
        else
            if high >= tpLevel
                strategy.close("Long", comment="TP")
                lastExitBar := bar_index
                tradeDir := 0
            else if low <= slLevel
                strategy.close("Long", comment="SL")
                lastExitBar := bar_index
                tradeDir := 0

    if tradeDir == -1
        activatePx = entryPx - trailActivateRR * riskAmt
        if not trailActive and low <= activatePx
            trailActive := true
            trailSL := close + trailMultiplier * at

        if trailActive
            newTrail = close + trailMultiplier * at
            if newTrail < trailSL
                trailSL := newTrail
            if low <= tpLevel
                strategy.close("Short", comment="TP")
                lastExitBar := bar_index
                tradeDir := 0
            else if high >= trailSL
                strategy.close("Short", comment="TRAIL")
                lastExitBar := bar_index
                tradeDir := 0
        else
            if low <= tpLevel
                strategy.close("Short", comment="TP")
                lastExitBar := bar_index
                tradeDir := 0
            else if high >= slLevel
                strategy.close("Short", comment="SL")
                lastExitBar := bar_index
                tradeDir := 0

// Reset on flat
if strategy.position_size == 0
    tradeDir := 0
    trailActive := false

// ══════════════════════════════════════════════════════════════
// 7. VISUALS
// ══════════════════════════════════════════════════════════════

// EMAs
plot(emaFast, "EMA 21", color=color.new(#FF9800, 20), linewidth=1)
plot(emaSlow, "EMA 55", color=color.new(#2196F3, 20), linewidth=1)
plot(emaTrend, "EMA 200", color=color.new(color.gray, 30), linewidth=2)

// Structure bias
bgcolor(bias == 1 ? color.new(#00C853, 95) : bias == -1 ? color.new(#FF1744, 95) : na)

// Structure breaks
plotshape(structureBreakUp, "Break Up", shape.triangleup, location.belowbar, color.new(#00C853, 0), size=size.tiny)
plotshape(structureBreakDn, "Break Down", shape.triangledown, location.abovebar, color.new(#FF1744, 0), size=size.tiny)

// Entries
plotshape(longCondition, "Long", shape.labelup, location.belowbar, color.new(#00C853, 0), text="L", textcolor=color.white, size=size.small)
plotshape(shortCondition, "Short", shape.labeldown, location.abovebar, color.new(#FF1744, 0), text="S", textcolor=color.white, size=size.small)

// SL/TP levels
plot(strategy.position_size > 0 and tradeDir == 1 ? slLevel : na, "SL Long", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 and tradeDir == 1 ? tpLevel : na, "TP Long", color=color.new(#00C853, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and tradeDir == -1 ? slLevel : na, "SL Short", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and tradeDir == -1 ? tpLevel : na, "TP Short", color=color.new(#00C853, 0), style=plot.style_linebr, linewidth=1)
plot(trailActive and strategy.position_size != 0 ? trailSL : na, "Trail SL", color=color.new(#E040FB, 0), style=plot.style_linebr, linewidth=2)

// ══════════════════════════════════════════════════════════════
// 8. INFO TABLE
// ══════════════════════════════════════════════════════════════

var table infoTbl = table.new(position.top_right, 2, 8, bgcolor=color.new(#0d1117, 85), border_width=1, border_color=color.new(#30363d, 50))

if barstate.islast
    table.cell(infoTbl, 0, 0, "SMC Hybrid v1", text_color=#e94560, text_size=size.small, text_halign=text.align_left)
    table.cell(infoTbl, 1, 0, bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "—",
         text_color=bias == 1 ? #00C853 : bias == -1 ? #FF1744 : color.gray, text_size=size.small)

    table.cell(infoTbl, 0, 1, "EMA Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, 1, bullTrend ? "UP" : bearTrend ? "DOWN" : "FLAT",
         text_color=bullTrend ? #00C853 : bearTrend ? #FF1744 : color.gray, text_size=size.tiny)

    table.cell(infoTbl, 0, 2, "Bull OB", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, 2, bullOBActive ? str.tostring(bullOBLow, "#") + "–" + str.tostring(bullOBHigh, "#") : "—",
         text_color=bullOBActive ? #00C853 : color.gray, text_size=size.tiny)

    table.cell(infoTbl, 0, 3, "Bear OB", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, 3, bearOBActive ? str.tostring(bearOBLow, "#") + "–" + str.tostring(bearOBHigh, "#") : "—",
         text_color=bearOBActive ? #FF1744 : color.gray, text_size=size.tiny)

    table.cell(infoTbl, 0, 4, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, 4, str.tostring(rsiVal, "#.0"), text_color=rsiOk ? color.white : color.red, text_size=size.tiny)

    table.cell(infoTbl, 0, 5, "ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, 5, str.tostring(atrVal, "#.0"), text_color=color.white, text_size=size.tiny)

    table.cell(infoTbl, 0, 6, "Cooldown", text_color=color.gray, text_size=size.tiny)
    coolRemain = math.max(0, cooldownBars - (bar_index - lastExitBar))
    table.cell(infoTbl, 1, 6, coolRemain > 0 ? str.tostring(coolRemain) + " bars" : "Ready",
         text_color=coolRemain > 0 ? color.orange : #00C853, text_size=size.tiny)

    table.cell(infoTbl, 0, 7, "Trail", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTbl, 1, 7, trailActive ? "ACTIVE" : "—",
         text_color=trailActive ? #E040FB : color.gray, text_size=size.tiny)

// ══════════════════════════════════════════════════════════════
// 9. ALERTS — Webhook Integration
// ══════════════════════════════════════════════════════════════

alertcondition(longCondition, "SMC Long Entry",
     '{"action":"long","ticker":"{{ticker}}","price":"{{close}}","time":"{{timenow}}","tf":"4H"}')
alertcondition(shortCondition, "SMC Short Entry",
     '{"action":"short","ticker":"{{ticker}}","price":"{{close}}","time":"{{timenow}}","tf":"4H"}')
