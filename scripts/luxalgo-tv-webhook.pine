// LuxAlgo EMA Trend v3.4 — Production-Ready (Final)
// All 5 AI reviews applied: Genspark, Gemini, ChatGPT (3 rounds), Claude
// Fixes: order-fill alerts, frozenATR consistency, explicit qty, split exit types
// BTCUSDT 4H | Bybit Perpetual

//@version=6
strategy("LuxAlgo EMA Trend v3.4", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=70,
     commission_type=strategy.commission.percent, commission_value=0.055,
     slippage=3, initial_capital=10000, currency=currency.USD,
     pyramiding=0, calc_on_every_tick=false,
     process_orders_on_close=true, margin_long=100, margin_short=100)

// ══════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════

emaFastLen     = input.int(13, "EMA Fast", group="EMA")
emaSlowLen     = input.int(89, "EMA Slow", group="EMA")
emaTrendLen    = input.int(200, "EMA Trend", group="EMA")

atrPeriod      = input.int(14, "ATR Period", group="Risk")
slMult         = input.float(2.0, "SL × ATR", step=0.5, group="Risk")
tpMult         = input.float(6.0, "TP × ATR", step=0.5, group="Risk")
useTrail       = input.bool(true, "Use Trailing Stop", group="Risk")
trailMult      = input.float(2.5, "Trail Activate × ATR", step=0.5, group="Risk")
trailOffsetMult = input.float(1.0, "Trail Offset × ATR", step=0.25, group="Risk")

rsiLen         = input.int(14, "RSI Period", group="Filter")
rsiLow         = input.float(30, "RSI Low", group="Filter")
rsiHigh        = input.float(70, "RSI High", group="Filter")
adxLen         = input.int(14, "ADX Period", group="Filter")
adxMin         = input.float(25, "ADX Minimum", group="Filter")
chopLen        = input.int(14, "Chop Index Length", group="Filter")
chopMax        = input.float(61.8, "Chop Max", step=0.5, group="Filter")

webhookSecret  = input.string("luxalgo-smc-2026", "Webhook Secret", group="Webhook")

startDate      = input.time(timestamp("2025-01-01"), "Start", group="Date")
endDate        = input.time(timestamp("2027-12-31"), "End", group="Date")
inRange        = time >= startDate and time <= endDate

// ══════════════════════════════════════════════════════════════
// INDICATORS
// ══════════════════════════════════════════════════════════════

ef = ta.ema(close, emaFastLen)
es = ta.ema(close, emaSlowLen)
et = ta.ema(close, emaTrendLen)
atrVal = ta.atr(atrPeriod)
rsiVal = ta.rsi(close, rsiLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

etSlopePct = (et - et[10]) / et[10] * 100
etRising  = etSlopePct > 0.1
etFalling = etSlopePct < -0.1

chopHigh = ta.highest(high, chopLen)
chopLow  = ta.lowest(low, chopLen)
chopRange = chopHigh - chopLow
chopCI   = chopRange > 0 ? 100 * math.log10(math.sum(ta.tr, chopLen) / chopRange) / math.log10(chopLen) : 50
isTrending = chopCI < chopMax

// ══════════════════════════════════════════════════════════════
// STATE — Clean lifecycle
// ══════════════════════════════════════════════════════════════

var bool lastWasWin = true
var bool exitPlaced = false
var float frozenATR = na

if ta.change(strategy.closedtrades) > 0
    lastWasWin := strategy.closedtrades.profit(strategy.closedtrades - 1) > 0
    exitPlaced := false
    frozenATR  := na

// ══════════════════════════════════════════════════════════════
// ENTRY CONDITIONS
// ══════════════════════════════════════════════════════════════

crossUp = ta.crossover(ef, es)
crossDn = ta.crossunder(ef, es)

bullTrend = close > et and ef > et and etRising
bearTrend = close < et and ef < et and etFalling

pullbackLong  = lastWasWin and bullTrend and ef > es and low <= es and close > es and close > open and (close - open) > (high - low) * 0.5
pullbackShort = lastWasWin and bearTrend and ef < es and high >= es and close < es and close < open and (open - close) > (high - low) * 0.5

rsiOk = rsiVal > rsiLow and rsiVal < rsiHigh
adxOk = adxVal > adxMin

longCond  = inRange and (crossUp or pullbackLong) and bullTrend and rsiOk and adxOk and isTrending and strategy.position_size == 0
shortCond = inRange and (crossDn or pullbackShort) and bearTrend and rsiOk and adxOk and isTrending and strategy.position_size == 0

// ══════════════════════════════════════════════════════════════
// EXECUTION — order-fill alerts via alert_message (fix: was condition-only)
// ══════════════════════════════════════════════════════════════

// Helper: frozenATR to mintick points (fix: was using live atrVal)
frozenPoints(mult) =>
    not na(frozenATR) ? math.round((mult * frozenATR) / syminfo.mintick) : na

// ── Entry with alert_message (fires on actual fill, not just condition) ──
if longCond
    frozenATR := atrVal
    exitPlaced := false
    entryReason = crossUp ? "cross" : "pullback"
    strategy.entry("Long", strategy.long, comment="L-Entry",
         alert_message='{"secret":"' + webhookSecret + '","action":"long","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close, "#.##") + ',"sl":' + str.tostring(close - slMult * atrVal, "#.##") + ',"tp":' + str.tostring(close + tpMult * atrVal, "#.##") + ',"qty_percent":70,"reason":"' + entryReason + '"}')

if shortCond
    frozenATR := atrVal
    exitPlaced := false
    entryReason = crossDn ? "cross" : "pullback"
    strategy.entry("Short", strategy.short, comment="S-Entry",
         alert_message='{"secret":"' + webhookSecret + '","action":"short","ticker":"' + syminfo.ticker + '","price":' + str.tostring(close, "#.##") + ',"sl":' + str.tostring(close + slMult * atrVal, "#.##") + ',"tp":' + str.tostring(close - tpMult * atrVal, "#.##") + ',"qty_percent":70,"reason":"' + entryReason + '"}')

// ── Exit placement: position_avg_price + frozenATR (fully consistent) ──
if strategy.position_size > 0 and not exitPlaced and not na(frozenATR)
    avgPx = strategy.position_avg_price
    slPrice = avgPx - slMult * frozenATR
    tpPrice = avgPx + tpMult * frozenATR
    tPoints = useTrail ? frozenPoints(trailMult) : na
    tOff    = useTrail ? frozenPoints(trailOffsetMult) : na

    strategy.exit("L-Exit", "Long", stop=slPrice, limit=tpPrice,
         trail_points=tPoints, trail_offset=tOff,
         comment_loss="L-SL", comment_profit="L-TP", comment_trailing="L-Trail",
         alert_loss='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"sl","comment":"Stop Loss"}',
         alert_profit='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"tp","comment":"Take Profit"}',
         alert_trailing='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"trail","comment":"Trailing Stop"}')
    exitPlaced := true

if strategy.position_size < 0 and not exitPlaced and not na(frozenATR)
    avgPx = strategy.position_avg_price
    slPrice = avgPx + slMult * frozenATR
    tpPrice = avgPx - tpMult * frozenATR
    tPoints = useTrail ? frozenPoints(trailMult) : na
    tOff    = useTrail ? frozenPoints(trailOffsetMult) : na

    strategy.exit("S-Exit", "Short", stop=slPrice, limit=tpPrice,
         trail_points=tPoints, trail_offset=tOff,
         comment_loss="S-SL", comment_profit="S-TP", comment_trailing="S-Trail",
         alert_loss='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"sl","comment":"Stop Loss"}',
         alert_profit='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"tp","comment":"Take Profit"}',
         alert_trailing='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"trail","comment":"Trailing Stop"}')
    exitPlaced := true

// ── Trend Reversal Exit ──
if strategy.position_size > 0 and ta.crossunder(ef, es) and close < es
    strategy.close("Long", comment="Trend-Rev",
         alert_message='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"trend_rev","comment":"EMA reversal close long"}')
    exitPlaced := false
    frozenATR := na

if strategy.position_size < 0 and ta.crossover(ef, es) and close > es
    strategy.close("Short", comment="Trend-Rev",
         alert_message='{"secret":"' + webhookSecret + '","action":"close","ticker":"' + syminfo.ticker + '","exit_type":"trend_rev","comment":"EMA reversal close short"}')
    exitPlaced := false
    frozenATR := na

// ══════════════════════════════════════════════════════════════
// PLOTS
// ══════════════════════════════════════════════════════════════

pFast = plot(ef, "EMA 13", color=color.new(#FF9800, 10), linewidth=2)
pSlow = plot(es, "EMA 89", color=color.new(#2196F3, 10), linewidth=2)
plot(et, "EMA 200", color=color.new(color.gray, 30), linewidth=2)

fill(pFast, pSlow, color=ef > es ? color.new(#00C853, 90) : color.new(#FF1744, 90))
bgcolor(bullTrend ? color.new(#00C853, 96) : bearTrend ? color.new(#FF1744, 96) : na)

plotshape(longCond, "Long", shape.labelup, location.belowbar, #00C853, text="L", textcolor=color.white, size=size.small)
plotshape(shortCond, "Short", shape.labeldown, location.abovebar, #FF1744, text="S", textcolor=color.white, size=size.small)

avgPx = strategy.position_avg_price
plot(strategy.position_size > 0 and not na(frozenATR) ? avgPx - slMult * frozenATR : na, "SL", color.red, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size > 0 and not na(frozenATR) ? avgPx + tpMult * frozenATR : na, "TP", #00C853, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and not na(frozenATR) ? avgPx + slMult * frozenATR : na, "SL-S", color.red, style=plot.style_linebr, linewidth=1)
plot(strategy.position_size < 0 and not na(frozenATR) ? avgPx - tpMult * frozenATR : na, "TP-S", #00C853, style=plot.style_linebr, linewidth=1)

// ══════════════════════════════════════════════════════════════
// INFO TABLE
// ══════════════════════════════════════════════════════════════

var table tbl = table.new(position.top_right, 2, 8, bgcolor=color.new(#0d1117, 85), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "EMA Trend v3.4", text_color=#e94560, text_size=size.small)
    table.cell(tbl, 1, 0, bullTrend ? "BULL" : bearTrend ? "BEAR" : "FLAT", text_color=bullTrend ? #00C853 : bearTrend ? #FF1744 : color.gray, text_size=size.small)
    table.cell(tbl, 0, 1, "EMA Cross", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 1, ef > es ? "BULL" : "BEAR", text_color=ef > es ? #00C853 : #FF1744, text_size=size.tiny)
    table.cell(tbl, 0, 2, "EMA200", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 2, str.tostring(etSlopePct, "#.##") + "%", text_color=etRising ? #00C853 : etFalling ? #FF1744 : color.gray, text_size=size.tiny)
    table.cell(tbl, 0, 3, "ADX", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 3, str.tostring(adxVal, "#.0"), text_color=adxOk ? color.white : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 4, "RSI", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 4, str.tostring(rsiVal, "#.0"), text_color=rsiOk ? color.white : color.red, text_size=size.tiny)
    table.cell(tbl, 0, 5, "Chop", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 5, str.tostring(chopCI, "#.0") + (isTrending ? " TREND" : " CHOP"), text_color=isTrending ? #00C853 : color.orange, text_size=size.tiny)
    table.cell(tbl, 0, 6, "ATR", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 6, str.tostring(atrVal, "#.0"), text_color=color.white, text_size=size.tiny)
    posStr = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    table.cell(tbl, 0, 7, "Position", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 7, posStr, text_color=strategy.position_size > 0 ? #00C853 : strategy.position_size < 0 ? #FF1744 : color.gray, text_size=size.tiny)
